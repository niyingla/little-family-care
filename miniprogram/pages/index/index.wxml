<import src="templates/today.wxml" />
<import src="templates/tasks.wxml" />
<import src="templates/family.wxml" />
<import src="templates/forms.wxml" />
<import src="templates/photo-wall.wxml" />
<view class="page">
  <view wx:if="{{!ready}}" class="loading">正在打开我家日常小事簿…</view>
  <block wx:elif="{{gate}}">
    <view class="welcome-art">
      <view class="sun">☀</view>
      <view class="little-house">♡</view>
      <view class="spark s1">✦</view>
      <view class="spark s2">✧</view>
    </view>
    <view class="eyebrow">LITTLE MOMENTS, TOGETHER</view>
    <view class="welcome-title">我家日常小事簿</view>
    <view class="welcome-sub">
      <view>把照顾宝宝的小事，</view>
      <view>一起记在心上。</view>
    </view>
    <view class="card gate-card">
      <view class="section-title">欢迎回家 ♡</view>
      <view class="muted">只对管理员邀请的家人开放，安心记录每一天。</view>
      <block wx:if="{{cloudAvailable}}">
        <input
          class="field"
          placeholder="你在家中的称呼，如：妈妈"
          maxlength="12"
          value="{{joinName}}"
          data-field="joinName"
          bindinput="input"
        />
        <block wx:if="{{bootstrap.canCreate}}">
          <button class="primary" loading="{{busy}}" bindtap="createFamily">创建我的家庭</button>
        </block>
        <block wx:elif="{{token}}">
          <view class="form-label">
            家庭身份
            <text class="muted">选填</text>
          </view>
          <input
            class="field"
            placeholder="例如：妈妈、爸爸、奶奶、爷爷或其他"
            maxlength="12"
            value="{{joinRelation}}"
            data-field="joinRelation"
            bindinput="input"
          />
          <view wx:if="{{inviteNotice}}" class="notice">{{inviteNotice}}</view>
          <view wx:if="{{inviteLoading}}" class="muted">正在读取邀请资料…</view>
          <button
            class="primary"
            loading="{{busy || inviteLoading}}"
            disabled="{{busy || inviteLoading}}"
            bindtap="joinFamily"
          >
            加入家庭
          </button>
        </block>
        <view wx:else class="notice">请让管理员给你发送邀请卡片，再从微信聊天打开加入。</view>
        <view wx:if="{{!bootstrap.ownerConfigured}}" class="notice">
          家庭尚未设置，请联系管理员完成初始化。
        </view>
      </block>
      <view wx:else class="notice">家庭共享服务尚未准备好，可以先体验界面与任务功能。</view>
      <button class="soft" bindtap="startDemo">先体验一下</button>
      <button class="text-button" bindtap="openReviewLogin" disabled="{{busy}}">
        审核专用登录
      </button>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="footer-note">小小的事，有家人一起就很好。</view>
  </block>
  <block wx:else>
    <view wx:if="{{reviewMode}}" class="notice">
      <view class="section-row">
        <text>审核专用 · 隔离测试数据</text>
        <button class="text-button" size="mini" bindtap="exitReview" disabled="{{busy}}">
          退出审核
        </button>
      </view>
      <view class="muted">本环境不读取真实家庭资料，也不发送真实微信通知。</view>
    </view>
    <view wx:if="{{demo}}" class="demo-banner">
      <text>本地体验 · 示例家庭 · 不发送微信通知</text>
      <text class="demo-exit" bindtap="leaveDemo">退出</text>
    </view>
    <view class="heading">
      <view>
        <view class="eyebrow">OUR LITTLE FAMILY</view>
        <view class="brand">
          我家日常小事簿
          <text class="brand-flower">✿</text>
        </view>
      </view>
      <view class="family-badge" bindtap="switchTab" data-id="family">♡ 一起照顾</view>
    </view>
    <view wx:if="{{error}}" class="error">
      {{error}}
      <text bindtap="refresh">点击重试</text>
    </view>
    <view wx:if="{{view !== 'family' && view !== 'photos'}}" class="scope-tabs">
      <view
        class="scope-tab {{scope === 'baby' ? 'active' : ''}}"
        data-id="baby"
        bindtap="switchScope"
      >
        <text>✿</text>
        宝宝事项
      </view>
      <view
        class="scope-tab {{scope === 'family' ? 'active' : ''}}"
        data-id="family"
        bindtap="switchScope"
      >
        <text>⌂</text>
        家庭事项
      </view>
    </view>
    <scroll-view
      wx:if="{{view !== 'family' && view !== 'photos' && scope === 'baby'}}"
      scroll-x
      class="baby-scroll"
    >
      <view class="baby-pills">
        <view
          class="baby-pill {{selectedBaby === 'all' ? 'selected' : ''}}"
          data-id="all"
          bindtap="selectBaby"
        >
          <view class="mini-avatar all-avatar">♡</view>
          <text>全部宝宝</text>
        </view>
        <view
          wx:for="{{babies}}"
          wx:key="id"
          class="baby-pill {{selectedBaby === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectBaby"
        >
          <image
            wx:if="{{item.picture}}"
            class="mini-avatar"
            data-kind="baby"
            data-id="{{item.id}}"
            catchtap="previewFamilyAvatar"
            src="{{item.picture}}"
            mode="aspectFill"
          />
          <view wx:else class="mini-avatar {{item.color}}">{{item.initial}}</view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <template
      wx:if="{{(view === 'today' || view === 'history') && !timelinePending}}"
      is="timeline"
      data="{{view,scope,date,today,createdDate,rows,total,doneCount,progress,filter,events,busy,messages,demo,sharedTaskId,sharedTaskNotice}}"
    />
    <view wx:if="{{(view === 'today' || view === 'history') && timelinePending}}" class="loading">
      {{refreshing ? '正在读取这一天的记录…' : '这一天的记录尚未加载，请下拉重试。'}}
    </view>
    <template wx:if="{{view === 'tasks'}}" is="tasks" data="{{scope,taskList,busy}}" />
    <template
      wx:if="{{view === 'photos'}}"
      is="photoWall"
      data="{{demo,busy,wallPosts,wallCursor,wallLoading,wallNotice,wallBabyOptions,wallBabyIndex,wallComposerBabies,wallComposerIndex,wallComposerOpen,wallDraft,wallUploading}}"
    />
    <template
      wx:if="{{view === 'family'}}"
      is="family"
      data="{{babies,members,owner,requests,profileName,profileMemberId,profileEditorOpen,configured,subscribed,demo,busy,birthdayMessages}}"
    />
    <view class="footer-note">一起照顾，也记得照顾自己 ♡</view>
    <view class="bottom-nav">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="nav-item {{view === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="navigateTab"
      >
        <view class="nav-icon">{{item.icon}}</view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </block>
  <template
    wx:if="{{modal}}"
    is="forms"
    data="{{modal,form,babyForm,today,week,frequencies,taskBabies,taskMembers,memberIndex,notifyOptions,notifyIndex,busy,inviteToken,inviteForm,birthdayForm,birthdayMonths,birthdayDays}}"
  />
</view>
