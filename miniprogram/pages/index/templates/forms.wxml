<import src="birthdays.wxml" />
<template name="forms">
  <view class="modal-backdrop" bindtap="closeModal">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle" />
      <view class="sheet-heading">
        <view class="section-title">
          {{modal === 'task' ? (form.taskId ? '调整这件小事' : '添加一件小事') : modal === 'baby' ?
          '宝宝的小档案' : modal === 'birthday' ? '记住家人的生日' : '邀请家人一起照顾'}}
        </view>
        <button class="close-button" bindtap="closeModal">×</button>
      </view>
      <scroll-view class="sheet-body" scroll-y>
        <block wx:if="{{modal === 'task'}}">
          <view class="notice">
            <text wx:if="{{form.scope === 'family'}}">家庭事项 · 不关联宝宝，由家人一起分担。</text>
            <text wx:else>宝宝事项 · 关联具体宝宝，独立记录完成情况。</text>
          </view>
          <view class="form-label">需要做什么</view>
          <input
            class="field"
            placeholder="例如：整理外出用品"
            maxlength="60"
            value="{{form.title}}"
            data-field="form.title"
            bindinput="input"
          />
          <view wx:if="{{form.scope !== 'family'}}" class="form-label">
            哪位宝宝的小事
            <text class="muted">{{form.taskId ? '宝宝归属不变' : '可多选，分别打勾'}}</text>
          </view>
          <view wx:if="{{form.scope !== 'family'}}" class="choices">
            <view
              wx:for="{{taskBabies}}"
              wx:key="id"
              class="choice {{item.selected ? 'on' : ''}}"
              data-id="{{item.id}}"
              bindtap="chooseTaskBaby"
            >
              {{item.name}} {{item.selected ? '✓' : ''}}
            </view>
          </view>
          <view class="form-label">重复周期</view>
          <view class="choices">
            <view
              wx:for="{{frequencies}}"
              wx:key="id"
              class="choice {{form.frequency === item.id ? 'on' : ''}}"
              data-id="{{item.id}}"
              bindtap="chooseFrequency"
            >
              {{item.label}}
            </view>
          </view>
          <view wx:if="{{form.frequency === 'interval'}}" class="interval-row">
            <text>每</text>
            <input
              class="field interval-input"
              type="number"
              value="{{form.interval}}"
              data-field="form.interval"
              bindinput="input"
            />
            <text>天一次</text>
            <text class="muted">2天一次就是隔一天</text>
          </view>
          <view wx:if="{{form.frequency === 'weekly'}}" class="week-choices">
            <view
              wx:for="{{week}}"
              wx:key="n"
              class="week-choice {{item.selected ? 'on' : ''}}"
              data-n="{{item.n}}"
              bindtap="chooseWeekday"
            >
              {{item.label}}
            </view>
          </view>
          <view class="form-label">{{form.frequency === 'once' ? '执行日期' : '从哪天开始'}}</view>
          <picker
            mode="date"
            value="{{form.startDate}}"
            bindchange="input"
            data-field="form.startDate"
          >
            <view class="field picker-value">
              {{form.startDate}}
              <text>⌄</text>
            </view>
          </picker>
          <view class="form-label">
            由谁负责
            <text class="muted">选填</text>
          </view>
          <picker
            range="{{taskMembers}}"
            range-key="name"
            value="{{memberIndex}}"
            bindchange="chooseMember"
          >
            <view class="field picker-value">
              {{taskMembers[memberIndex].name}}
              <text>⌄</text>
            </view>
          </picker>
          <view class="form-label">
            执行时间
            <text class="muted">可以不设置</text>
          </view>
          <picker
            mode="time"
            value="{{form.executionTime || '09:00'}}"
            bindchange="input"
            data-field="form.executionTime"
          >
            <view class="field picker-value">
              {{form.executionTime || '未设置，点击选择'}}
              <text>⌄</text>
            </view>
          </picker>
          <button wx:if="{{form.executionTime}}" class="text-button" bindtap="clearExecutionTime">
            清除执行时间
          </button>
          <view class="form-label">
            超时后通知谁
            <text class="muted">选填</text>
          </view>
          <picker
            range="{{notifyOptions}}"
            range-key="name"
            value="{{notifyIndex}}"
            bindchange="chooseNotifyMember"
          >
            <view class="field picker-value">
              {{notifyOptions[notifyIndex].name}}
              <text>⌄</text>
            </view>
          </picker>
          <view class="muted footnote">
            {{form.executionTime ? '超过执行时间30分钟仍未完成，才通知选定家人。' :
            '未设置执行时间，不自动发超时通知；仍可手动提醒。'}}
          </view>
          <view class="notice">
            {{form.taskId ? '修改从明天起生效，今天与历史记录不变。' :
            '按北京时间安排。过去的开始日期会从今天算起，不补写历史。'}}
            微信提醒需被通知人主动订阅授权。
          </view>
          <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveTask">
            {{form.taskId ? '保存调整' : '把小事记下来'}}
          </button>
        </block>
        <block wx:elif="{{modal === 'baby'}}">
          <view class="avatar-upload" bindtap="chooseAvatar">
            <image
              wx:if="{{babyForm.picture}}"
              src="{{babyForm.picture}}"
              class="upload-picture"
              mode="aspectFill"
            />
            <view wx:else class="upload-placeholder">♡</view>
            <view class="muted">点击选头像 · 相册或拍照</view>
          </view>
          <view class="form-label">宝宝的名字或昵称</view>
          <input
            class="field"
            placeholder="家里怎么叫TA呢？"
            maxlength="12"
            value="{{babyForm.name}}"
            data-field="babyForm.name"
            bindinput="input"
          />
          <view class="notice">名字和头像仅对已加入的家庭成员可见。支持10MB以内JPG或PNG图片。</view>
          <button class="primary" bindtap="saveBaby" disabled="{{busy}}" loading="{{busy}}">
            保存宝宝资料
          </button>
        </block>
        <block wx:elif="{{modal === 'birthday'}}">
          <template is="birthdayEditor" data="{{birthdayForm,birthdayMonths,birthdayDays,busy}}" />
        </block>
        <block wx:else>
          <view class="invite-art">♡</view>
          <view class="muted">只有你能邀请家人。卡片24小时有效，仅供一人加入，无需再次审核。</view>
          <block wx:if="{{!inviteToken}}">
            <view class="form-label">
              家人的称呼
              <text class="muted">选填</text>
            </view>
            <input
              class="field"
              maxlength="12"
              placeholder="例如：晓红"
              value="{{inviteForm.name}}"
              data-field="inviteForm.name"
              bindinput="input"
            />
            <view class="form-label">
              家庭身份
              <text class="muted">选填</text>
            </view>
            <input
              class="field"
              maxlength="12"
              placeholder="例如：妈妈、爸爸、奶奶、爷爷或其他"
              value="{{inviteForm.relation}}"
              data-field="inviteForm.relation"
              bindinput="input"
            />
            <view class="notice">
              你可以预先填写，对方打开邀请后确认或修改。家庭身份仅作展示，管理权限仍由你掌握。
            </view>
            <button class="primary" bindtap="makeInvite" disabled="{{busy}}" loading="{{busy}}">
              生成邀请
            </button>
          </block>
          <block wx:else>
            <view wx:if="{{inviteForm.name || inviteForm.relation}}" class="notice">
              <view wx:if="{{inviteForm.name}}">家人称呼：{{inviteForm.name}}</view>
              <view wx:if="{{inviteForm.relation}}">家庭身份：{{inviteForm.relation}}</view>
              <view>对方加入后，称呼和家庭身份会出现在家人列表。</view>
            </view>
            <button class="primary" open-type="share">发邀请给家人</button>
          </block>
        </block>
      </scroll-view>
    </view>
  </view>
</template>
