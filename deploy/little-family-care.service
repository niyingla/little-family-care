[Unit]
Description=Little Family Care API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=littlecare
Group=littlecare
WorkingDirectory=/opt/little-family-care/current
EnvironmentFile=/etc/little-family-care.env
ExecStart=/opt/little-family-care/runtime/node-v24.15.0-linux-x64/bin/node selfhost/main.cjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/little-family-care
UMask=0077
MemoryMax=512M

[Install]
WantedBy=multi-user.target
