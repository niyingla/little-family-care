[Unit]
Description=Little Family Care HTTP Proxy
After=network.target little-family-care.service
Wants=little-family-care.service

[Service]
Type=forking
PIDFile=/run/little-family-care-nginx.pid
ExecStartPre=/usr/sbin/nginx -t -c /etc/little-family-care/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/little-family-care/nginx.conf
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -QUIT $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
